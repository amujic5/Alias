    <string name="htp_step1_body">Two or more teams face off. Each team has two players who take turns explaining and guessing.</string>
    <string name="htp_step2_title">Explain the word</string>
    <string name="htp_step2_body">One player describes the word to their teammate — without ever saying the word itself or its root.</string>
    <string name="htp_step3_title">Guess to score</string>
    <string name="htp_step3_body">If your teammate guesses it, your team scores a point. Stuck on one? Skip it and keep going.</string>
