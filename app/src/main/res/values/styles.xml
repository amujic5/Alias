<resources>
    xmlns:app="http://schemas.android.com/apk/res-auto"


    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <!--
        Home's theme. No action bar, the same as every other screen in the app.

        It used to inherit one from AppTheme and overlay it, only for HomeActivity to hide
        it again in onPostCreate. The cost was not the wasted work: an action bar puts that
        one screen alone on AppCompat's heavy sub-decor path — inflate abc_screen_toolbar
        through a themed inflater, wire up a DecorContentParent, create a support ActionBar
        — and both "the window came up without a content container" crashes reported from
        this app came from that path, on this screen. The eleven activities already on
        AppTheme.NoActionBar have never reported it.

        windowBackground stays null on purpose: Compose paints its own, and an opaque one
        here only adds a flash of colour before the first frame.
    -->
    <style name="FullscreenTheme" parent="AppTheme.NoActionBar">
        <item name="android:windowBackground">@null</item>
    </style>

    <style name="SwitchTheme" parent="Theme.AppCompat.Light">
        <item name="android:colorControlActivated">@color/alias_green</item>
    </style>

    <style name="AppTheme.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <!--
        Only ever used by a relaunch after the window failed to build — see
        BaseActivity.recoverFromBrokenWindow. The one item is the whole point of it:
        PhoneWindow.generateLayout picks which of its own screen layouts to inflate from
        the window features, and windowActionModeOverlay moves it off screen_simple and
        onto screen_simple_overlay_action_mode. Same thing to look at — this app has no
        action modes to overlay — but a different framework layout, which is the only
        lever there is on a device whose copy of the first one is broken.
    -->
    <style name="RecoveryTheme" parent="AppTheme.NoActionBar">
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">@null</item>
    </style>

    <style name="AppTheme.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />

    <style name="AppTheme.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />

    <style name="TitleStyle">
        <item name="android:textSize">33sp</item>
        <item name="android:textColor">@android:color/white</item>
    </style>

</resources>
